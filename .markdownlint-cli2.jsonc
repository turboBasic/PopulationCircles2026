{
  // MD013 (line length) is a convention this project does not enforce — docs/ai-instructions.md
  // "Working style" says not to object over line length, and every living doc here already
  // exceeds 80 and often 100 columns by design.
  "config": {
    "default": true,
    "MD013": false
  },
  // GitHub renders the PR title as the page's heading, so this file starts at `##` on purpose.
  // MD041 (first line must be a top-level heading) is the only rule this trips, and it is the
  // only file in the repo that needs the exception, so the exception is scoped to it instead
  // of disabled project-wide.
  "overrides": [
    {
      "filter": [".github/PULL_REQUEST_TEMPLATE.md"],
      "config": { "MD041": false },
      "combine": "merge"
    },
    // Records 0001-0010 and the plans beside them write bold **Positive** / **Negative** labels
    // where MD036 wants headings. A record is frozen once accepted and a plan once complete
    // (docs/ai/platform.md "Architecture decisions" and "Implementation plans"), so none of them
    // can be edited to satisfy this rule and the override has to stay. Records from 0011 on do not
    // need it. docs/decisions/ is otherwise linted like anywhere else: this scopes the exception to
    // the one rule those files trip rather than exempting the directory from every future rule too.
    {
      "filter": ["docs/decisions/**"],
      "config": { "MD036": false },
      "combine": "merge"
    }
  ]
}
