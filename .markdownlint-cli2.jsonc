{
  // MD013 (line length) is a convention this project does not enforce — docs/ai-instructions.md
  // "Working style" says not to object over line length, and every living doc here already
  // exceeds 80 and often 100 columns by design.
  "config": {
    "default": true,
    "MD013": false
  },
  // GitHub renders the PR title as the page's heading, so this file starts at `##` on purpose.
  // MD041 (first line must be a top-level heading) is the only rule this trips, and it is the
  // only file in the repo that needs the exception, so the exception is scoped to it instead
  // of disabled project-wide.
  "overrides": [
    {
      "filter": [".github/PULL_REQUEST_TEMPLATE.md"],
      "config": { "MD041": false },
      "combine": "merge"
    },
    // The write-adr skill's Consequences section is bold **Positive** / **Negative** labels, not
    // headings — a template convention, not drift, and the only rule this trips across every
    // accepted ADR and plan. docs/decisions/ is otherwise linted like anywhere else: a record is
    // frozen once accepted or complete (docs/ai/platform.md "Architecture decisions" and
    // "Implementation plans"), so this scopes the exception to what the template actually does
    // rather than exempting the directory from every future rule too.
    {
      "filter": ["docs/decisions/**"],
      "config": { "MD036": false },
      "combine": "merge"
    }
  ]
}
