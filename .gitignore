# Everything cargo, ruff and pytest generate. .cargo/config.toml and pyproject.toml are what put it
# here, rather than each tool's own directory at the repository root.
/build/
# The conventional location, still ignored: an explicit `--target-dir` on the command line overrides
# .cargo/config.toml, and an editor's flycheck passes one. Config chooses where output goes; this line
# is what stops a producer that ignores the config from making it committable.
/target/

# Rust
**/*.rs.bk
*.pdb
# insta's pending snapshots, accepted into the .snap beside them or discarded
*.snap.new

# Python
.venv/
__pycache__/
*.py[cod]
.pyright/
# The wheel and sdist `uv build` writes, now that there is a package to build
/dist/

# Generated data products: summation tables, rendered maps, profiling output
*.bin
/out/
perf.data
perf.data.old

# Local environment
.env
.DS_Store
tmp/
# Per-developer permission allowlist. Committed here rather than left to a contributor's global
# excludes, so that `git check-ignore` gives the same answer in a clone as it does on the machine
# that created the file — which is what the lint-docs entry point relies on to tell a per-developer file
# from a broken pointer.
.claude/settings.local.json
