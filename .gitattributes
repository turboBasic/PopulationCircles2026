* text=auto eol=lf

*.rs text
*.py text
*.toml text
*.md text
*.yml text
*.yaml text
*.sh text eol=lf
*.snap text

# Raster population data. Tracked by LFS but deliberately not fetched on clone —
# see .lfsconfig and the `data:pull` mise task.
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

*.png binary
*.bin binary
