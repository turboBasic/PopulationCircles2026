* text=auto eol=lf

*.rs text
*.py text
*.pyi text
*.toml text
*.md text
*.yml text
*.yaml text
*.sh text eol=lf
*.snap text

# Raster population data. Tracked by LFS but deliberately not fetched on clone —
# see .lfsconfig and the `data:pull` mise task.
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text

# Vector basemap data, and deliberately not LFS: it is a hundred kilobytes that every
# clone and every CI job needs, so it is a Git blob. data/README.md says so under Data.
*.geojson text

*.png binary
*.bin binary
