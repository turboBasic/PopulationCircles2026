root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.rs]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.{toml,yml,yaml,json,jsonc}]
indent_size = 2

# insta generates these, so the layout is what it emits rather than what this file asks for.
[*.snap]
indent_size = 2
max_line_length = off

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab
